package gorm

import (
	"context"
	"errors"
	"time"

	"gorm.io/gorm"

	"{{.ModulePath}}/internal/domain/user"
)

// userRow is the postgres row DTO for user aggregates. It is intentionally
// private to this package: the domain aggregate is the only public contract.
type userRow struct {
	ID        string `gorm:"column:id;type:uuid;primaryKey"`
	Name      string `gorm:"column:name;not null"`
	Email     string `gorm:"column:email;not null;uniqueIndex"`
{{- if .Has "auth"}}
	Password  string `gorm:"column:password;not null"`
{{- end}}
	CreatedAt time.Time `gorm:"column:created_at;not null;default:current_timestamp"`
	UpdatedAt time.Time `gorm:"column:updated_at;not null;default:current_timestamp"`
}

// TableName pins the GORM-managed table name. The domain aggregate has no
// opinion about persistence; the adapter owns the table layout.
func (userRow) TableName() string { return "users" }

// toAggregate converts a row to a domain aggregate. The error from NewUserID
// is ignored because the column type guarantees the value is a non-empty
// uuid at the database level.
func (row *userRow) toAggregate() *user.User {
	id, _ := user.NewUserID(row.ID)
	u, _ := user.NewUser(id, row.Name, row.Email)
{{- if .Has "auth"}}
	u.SetPasswordHash(row.Password)
{{- end}}
	u.SetTimestamps(row.CreatedAt, row.UpdatedAt)
	return u
}

// rowFromAggregate projects a domain aggregate onto the row DTO.
func rowFromAggregate(u *user.User) *userRow {
	row := &userRow{
		ID:        u.ID().String(),
		Name:      u.Name(),
		Email:     u.Email(),
{{- if .Has "auth"}}
		Password:  u.PasswordHash(),
{{- end}}
		CreatedAt: u.CreatedAt(),
		UpdatedAt: u.UpdatedAt(),
	}
	return row
}

// UserRepository is the GORM-backed implementation of
// domain/user.Repository.
type UserRepository struct {
	db *gorm.DB
}

// NewUserRepository constructs a GORM-backed UserRepository.
func NewUserRepository(db *gorm.DB) *UserRepository {
	return &UserRepository{db: db}
}

// Save inserts a new row or updates an existing one keyed by id.
func (r *UserRepository) Save(ctx context.Context, u *user.User) error {
	return r.db.WithContext(ctx).Save(rowFromAggregate(u)).Error
}

// Get returns a user aggregate by id, mapping gorm.ErrRecordNotFound to
// domain/user.ErrUserNotFound.
func (r *UserRepository) Get(ctx context.Context, id user.UserID) (*user.User, error) {
	var row userRow
	err := r.db.WithContext(ctx).First(&row, "id = ?", id.String()).Error
	if errors.Is(err, gorm.ErrRecordNotFound) {
		return nil, user.ErrUserNotFound
	}
	if err != nil {
		return nil, err
	}
	return row.toAggregate(), nil
}

// GetByEmail returns a user aggregate by email address, or
// domain/user.ErrUserNotFound.
func (r *UserRepository) GetByEmail(ctx context.Context, email string) (*user.User, error) {
	var row userRow
	err := r.db.WithContext(ctx).First(&row, "email = ?", email).Error
	if errors.Is(err, gorm.ErrRecordNotFound) {
		return nil, user.ErrUserNotFound
	}
	if err != nil {
		return nil, err
	}
	return row.toAggregate(), nil
}

// List returns every user row as a domain aggregate.
func (r *UserRepository) List(ctx context.Context) ([]*user.User, error) {
	var rows []userRow
	if err := r.db.WithContext(ctx).Order("id ASC").Find(&rows).Error; err != nil {
		return nil, err
	}
	out := make([]*user.User, 0, len(rows))
	for i := range rows {
		out = append(out, rows[i].toAggregate())
	}
	return out, nil
}

// Delete removes a user row by id, mapping zero affected rows to
// domain/user.ErrUserNotFound.
func (r *UserRepository) Delete(ctx context.Context, id user.UserID) error {
	res := r.db.WithContext(ctx).Delete(&userRow{}, "id = ?", id.String())
	if err := res.Error; err != nil {
		return err
	}
	if res.RowsAffected == 0 {
		return user.ErrUserNotFound
	}
	return nil
}
