APP_NAME := {{.ProjectName}}
BIN_DIR  := bin

# Common development tasks (build, run, dev, test, fmt, vet, tidy, swag{{if .Has "postgres"}}, migrate{{end}})
# are provided by the `rev` CLI, so they are intentionally NOT duplicated here.
# Run `rev tools` to list them. This Makefile holds only targets that rev does
# not provide natively — add your own project-specific targets below. They can
# be run with either `make <target>` or `rev <target>` (rev transparently
# delegates unknown commands to this Makefile).

.PHONY: help clean

help:
	@echo "Common tasks are provided by the rev CLI:"
	@echo "  rev build        - compile the binary into $(BIN_DIR)/$(APP_NAME)"
	@echo "  rev run          - run the application"
	@echo "  rev dev          - run with live reload (air)"
	@echo "  rev test         - run all tests"
	@echo "  rev swag         - generate Swagger docs"
{{- if .Has "postgres"}}
	@echo "  rev migrate up   - apply database migrations"
	@echo "  rev make migration <name> - create an up/down migration pair"
{{- end}}
	@echo ""
	@echo "Project-specific Makefile targets:"
	@echo "  make clean       - remove build artifacts ($(BIN_DIR)/)"

clean:
	rm -rf $(BIN_DIR)
