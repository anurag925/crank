app:
  name: "{{.ProjectName}}"
  host: "0.0.0.0"
  port: 8080
  env: "development"
{{- if .Has "gorm"}}

database:
  host: "localhost"
  port: 5432
  user: "postgres"
  password: "postgres"
  name: "{{.PackageName}}"
  sslmode: "disable"
{{- end}}
{{- if .Has "auth"}}

jwt:
  secret: "change-me-in-production"
  expiration: 24h
  refresh_expiration: 168h
{{- end}}
{{- if .Has "crypto"}}

crypto:
  # Generate a strong secret with: openssl rand -base64 32
  secret: "change-me-in-production"
{{- end}}
{{- if .Has "redis"}}

redis:
  addr: "localhost:6379"
  password: ""
  db: 0
{{- end}}
{{- if .Has "mongodb"}}

mongodb:
  uri: "mongodb://localhost:27017"
  database: "{{.PackageName}}"
{{- end}}
{{- if .Has "qdrant"}}

qdrant:
  host: "localhost"
  port: 6334
  api_key: ""
  use_tls: false
{{- end}}
{{- if .Has "temporal"}}

temporal:
  host_port: "127.0.0.1:7233"
  namespace: "default"
  task_queue: "{{.PackageName}}-task-queue"
{{- end}}
{{- if .Has "views"}}

views:
  # Set enabled to true to serve the embedded React SPA.
  # For local frontend dev, set dev_server to your Vite URL (e.g. "http://localhost:5173").
  enabled: false
  dev_server: ""
{{- end}}
# crank:config-section
logging:
  level: "info"
  format: "json"
  # Set to true to include compressed source locations (e.g. handler/user.go:42)
  add_source: false
