app:
  name: "{{.ProjectName}}"
  host: "0.0.0.0"
  port: 8080
  env: "development"
{{- if .Has "postgres"}}

database:
  host: "localhost"
  port: 5432
  user: "postgres"
  password: "postgres"
  name: "{{.PackageName}}"
  sslmode: "disable"
{{- end}}
{{- if .Has "auth"}}

jwt:
  secret: "change-me-in-production"
  expiration: 24h
  refresh_expiration: 168h
{{- end}}
{{- if .Has "crypto"}}

crypto:
  # Generate a strong secret with: openssl rand -base64 32
  secret: "change-me-in-production"
{{- end}}

logging:
  level: "info"
  format: "json"
  # Set to true to include compressed source locations (e.g. handler/user.go:42)
  add_source: false
