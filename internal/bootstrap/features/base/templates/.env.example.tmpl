# Copy to .env and fill in real values. The .env file is git-ignored.
APP_PORT=8080
APP_ENV=development
{{- if or (.Has "bun") (.Has "gorm")}}

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME={{.PackageName}}
DB_SSLMODE=disable
{{- end}}
{{- if .Has "auth"}}

JWT_SECRET=change-me-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h
{{- end}}
{{- if .Has "crypto"}}

# Generate a strong secret with: openssl rand -base64 32
CRYPTO_SECRET=change-me-in-production
{{- end}}
{{- if .Has "redis"}}

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
{{- end}}
{{- if .Has "mongodb"}}

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE={{.PackageName}}
{{- end}}
{{- if .Has "qdrant"}}

QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_API_KEY=
QDRANT_USE_TLS=false
{{- end}}
{{- if .Has "temporal"}}

TEMPORAL_HOST_PORT=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE={{.PackageName}}-task-queue
{{- end}}
# crank:env-section
LOG_LEVEL=info
LOG_FORMAT=json
