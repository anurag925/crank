# Copy to .env and fill in real values. The .env file is git-ignored.
APP_PORT=8080
APP_ENV=development
{{- if .Has "postgres"}}

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME={{.PackageName}}
DB_SSLMODE=disable
{{- end}}
{{- if .Has "auth"}}

JWT_SECRET=change-me-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h
{{- end}}
{{- if .Has "crypto"}}

# Generate a strong secret with: openssl rand -base64 32
CRYPTO_SECRET=change-me-in-production
{{- end}}

LOG_LEVEL=info
LOG_FORMAT=json
