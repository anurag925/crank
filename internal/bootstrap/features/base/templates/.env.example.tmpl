# Copy to .env and fill in real values. The .env file is git-ignored.
# Only secrets belong here — all other settings live in configs/config.yaml.
{{- if or (.Has "bun") (.Has "gorm")}}

DATABASE_PASSWORD=postgres
{{- end}}
{{- if .Has "auth"}}

JWT_SECRET=change-me-in-production
{{- end}}
{{- if .Has "crypto"}}

# Generate a strong secret with: openssl rand -base64 32
CRYPTO_SECRET=change-me-in-production
{{- end}}
{{- if .Has "redis"}}

REDIS_PASSWORD=
{{- end}}
{{- if .Has "mongodb"}}

MONGODB_URI=mongodb://localhost:27017
{{- end}}
{{- if .Has "qdrant"}}

QDRANT_API_KEY=
{{- end}}
# crank:env-section
