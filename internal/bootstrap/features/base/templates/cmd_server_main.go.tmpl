package main

import (
	"context"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"strconv"
	"syscall"
	"time"

	"github.com/labstack/echo/v4"
	echomw "github.com/labstack/echo/v4/middleware"
	echoSwagger "github.com/swaggo/echo-swagger"
{{- if .Has "temporal"}}
	"go.temporal.io/sdk/worker"
{{- end}}

	_ "{{.ModulePath}}/docs"
{{- if .Has "bun"}}
	"{{.ModulePath}}/internal/adapters/persistence/bun"
{{- end}}
{{- if .Has "gorm"}}
	"{{.ModulePath}}/internal/adapters/persistence/gorm"
{{- end}}
	"{{.ModulePath}}/internal/adapters/eventbus"
	"{{.ModulePath}}/internal/adapters/http/web"
	"{{.ModulePath}}/internal/adapters/http/web/middleware"
{{- if and (not (.Has "bun")) (not (.Has "gorm"))}}
	"{{.ModulePath}}/internal/adapters/persistence/memory"
{{- end}}
{{- if not (.Has "outbox")}}
	"{{.ModulePath}}/internal/adapters/uow"
{{- end}}
	userapp "{{.ModulePath}}/internal/application/user"
	"{{.ModulePath}}/internal/config"
	"{{.ModulePath}}/internal/domain/user"
	"{{.ModulePath}}/internal/model"
	"{{.ModulePath}}/internal/validator"
	"{{.ModulePath}}/pkg/logging"
{{- if .Has "auth"}}
	"{{.ModulePath}}/internal/adapters/crypto"
{{- end}}
{{- if .Has "redis"}}
	redisclient "{{.ModulePath}}/internal/adapters/cache/redis"
{{- end}}
{{- if .Has "mongodb"}}
	"{{.ModulePath}}/internal/adapters/persistence/mongodb"
{{- end}}
{{- if .Has "qdrant"}}
	qdrantclient "{{.ModulePath}}/internal/adapters/persistence/qdrant"
{{- end}}
{{- if .Has "temporal"}}
	"{{.ModulePath}}/internal/adapters/temporal"
{{- end}}
{{- if .Has "otel"}}
	"{{.ModulePath}}/internal/adapters/telemetry"
{{- end}}
{{- if .Has "outbox"}}
	outboxadapter "{{.ModulePath}}/internal/adapters/outbox"
{{- end}}
)

// @title           {{.ProjectName}} API
// @version         1.0
// @description     Production-ready backend service scaffolded by crank.
//
// @host            localhost:8080
// @BasePath        /
//
// @accept          json
// @produce         json
//
// @securityDefinitions.apikey BearerAuth
// @in   header
// @name Authorization
// @description Enter "Bearer {token}" to authenticate.

func main() {
	cfg := config.Load()

	level := parseLevel(cfg.Logging.Level)
	logger := logging.New(level, cfg.Logging.AddSource)
	slog.SetDefault(logger)

	logger.Info("starting application",
		"app", cfg.App.Name,
		"env", cfg.App.Env,
		"log_level", cfg.Logging.Level,
	)
{{if .Has "bun"}}
	db, err := bun.NewDB(cfg.Database)
	if err != nil {
		logger.Error("failed to connect to database", "error", err)
		os.Exit(1)
	}
	defer func() { _ = db.Close() }()
{{end}}
{{if .Has "gorm"}}
	gormDB, err := gorm.NewDB(cfg.Database)
	if err != nil {
		logger.Error("failed to connect to database", "error", err)
		os.Exit(1)
	}
	defer func() {
		sqlDB, dbErr := gormDB.DB()
		if dbErr != nil {
			return
		}
		_ = sqlDB.Close()
	}()
{{end}}
{{if .Has "otel"}}
	tracerProvider, err := telemetry.NewProvider(context.Background(), telemetry.Config{
		ServiceName: cfg.Telemetry.ServiceName,
		Exporter:    cfg.Telemetry.Exporter,
	})
	if err != nil {
		logger.Error("failed to set up tracer", "error", err)
		os.Exit(1)
	}
	defer func() {
		shutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = tracerProvider.Shutdown(shutdownCtx)
	}()
{{end}}
{{if .Has "redis"}}
	rdb, err := redisclient.NewClient(cfg.Redis)
	if err != nil {
		logger.Error("failed to connect to redis", "error", err)
		os.Exit(1)
	}
	defer func() { _ = rdb.Close() }()
{{end}}
{{if .Has "mongodb"}}
	mdb, err := mongodb.NewClient(context.Background(), cfg.MongoDB)
	if err != nil {
		logger.Error("failed to connect to mongodb", "error", err)
		os.Exit(1)
	}
	defer func() { _ = mdb.Client().Disconnect(context.Background()) }()
{{end}}
{{if .Has "qdrant"}}
	qc, err := qdrantclient.NewClient(context.Background(), cfg.Qdrant)
	if err != nil {
		logger.Error("failed to connect to qdrant", "error", err)
		os.Exit(1)
	}
	defer func() { _ = qc.Close() }()
{{end}}
{{if .Has "temporal"}}
	tc, err := temporal.NewClient(cfg.Temporal, logger)
	if err != nil {
		logger.Error("failed to connect to temporal", "error", err)
		os.Exit(1)
	}
	defer tc.Close()
	go func() {
		w := temporal.NewWorker(tc, cfg.Temporal)
		if err := w.Run(worker.InterruptCh()); err != nil {
			logger.Error("temporal worker stopped with error", "error", err)
		}
	}()
{{end}}

	// ---- Composition root: explicit DDD wiring ----
	bus := eventbus.NewInMemory()
{{if .Has "bun"}}
	userRepo := bun.NewUserRepository(db)
{{else if .Has "gorm"}}
	userRepo := gorm.NewUserRepository(gormDB)
{{else}}
	userRepo := memory.NewUserRepository()
{{end}}
{{if .Has "outbox"}}
{{if .Has "bun"}}
	outboxRepo := bun.NewOutboxRepository(db)
	uow := outboxadapter.NewBunUoW(db, outboxRepo)
{{end}}
{{if .Has "gorm"}}
	outboxRepo := gorm.NewOutboxRepository(gormDB)
	uow := outboxadapter.NewGormUoW(gormDB, outboxRepo)
{{end}}
	outboxWorker := outboxadapter.NewWorker(outboxRepo, bus, logger, outboxadapter.Config{
		Interval:  cfg.Outbox.PollInterval,
		BatchSize: cfg.Outbox.BatchSize,
	})
{{else}}
	uow := uow.NewInMemoryUoW(bus)
{{end}}
{{if .Has "auth"}}
	hasher := crypto.NewBCryptHasher()
	tokens := crypto.NewJWTTokenService(cfg.JWT)
	_ = hasher
{{end}}
	userCmd := userapp.NewCommandHandler(userRepo, uow)
	userQry := userapp.NewQueryHandler(userRepo)
	userHandler := web.NewUserHandler(userCmd, userQry)

	e := web.NewServer(logger)
	e.HideBanner = true
	e.HidePort = true
	e.Use(echomw.Recover())
	e.Use(middleware.RequestLogger())
{{if .Has "otel"}}
	e.Use(middleware.Tracing(cfg.Telemetry.ServiceName))
{{end}}

	e.GET("/swagger/*", echoSwagger.EchoWrapHandler())
	e.GET("/health", web.Health)

	e.HTTPErrorHandler = func(err error, c echo.Context) {
		if c.Response().Committed {
			return
		}
		reqLog := logging.L(c.Request().Context())

		if ve, ok := err.(*validator.ValidationError); ok {
			reqLog.Warn("validation failed", "errors", ve.Errors)
			_ = c.JSON(ve.HTTPStatus, model.APIError{Error: ve.Message, Details: ve.Errors})
			return
		}
		if he, ok := err.(*echo.HTTPError); ok {
			if msg, ok := he.Message.(string); ok {
				_ = c.JSON(he.Code, model.APIError{Error: msg})
				return
			}
			_ = c.JSON(he.Code, echo.Map{"error": he.Message})
			return
		}
		reqLog.Error("unhandled error", "error", err)
		_ = c.JSON(http.StatusInternalServerError, model.APIError{Error: "internal server error"})
	}

	web.Mount(e, web.MountConfig{UserHandler: userHandler})
{{if .Has "auth"}}
	authHandler := web.NewAuthHandler(userCmd, userQry, tokens)
	authHandler.Register(e)
{{end}}
{{if .Has "views"}}
	web.ServeViews(e, cfg.Views, logger)
{{end}}

	addr := cfg.App.Host + ":" + strconv.Itoa(cfg.App.Port)
	logger.Info("server listening", "addr", addr)

{{if .Has "outbox"}}
	outboxCtx, outboxCancel := context.WithCancel(context.Background())
	defer outboxCancel()
	go outboxWorker.Run(outboxCtx)
{{end}}
	go func() {
		if err := e.Start(addr); err != nil && err != http.ErrServerClosed {
			logger.Error("server error", "error", err)
			os.Exit(1)
		}
	}()

	quit := make(chan os.Signal, 1)
	signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)
	<-quit

	logger.Info("shutting down server")
{{if .Has "outbox"}}
	outboxCancel()
{{end}}
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	if err := e.Shutdown(ctx); err != nil {
		logger.Error("server forced to shutdown", "error", err)
	}
}

func parseLevel(s string) slog.Level {
	switch s {
	case "debug":
		return slog.LevelDebug
	case "warn":
		return slog.LevelWarn
	case "error":
		return slog.LevelError
	default:
		return slog.LevelInfo
	}
}

var _ = user.ErrUserNotFound
