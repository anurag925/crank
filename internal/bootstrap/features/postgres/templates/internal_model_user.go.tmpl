package model

import (
	"time"

	"github.com/uptrace/bun"
)

// User is the domain model for application users. With the postgres feature
// selected it carries Bun ORM tags so it can be persisted as a "users" row.
type User struct {
	bun.BaseModel `bun:"table:users,alias:u"`

	ID        int64     `bun:"id,pk,autoincrement"                                                       json:"id"`
	Name      string    `bun:"name,notnull"         validate:"required,min=2,max=100"                          json:"name"`
	Email     string    `bun:"email,notnull,unique"  validate:"required,email"                                  json:"email"`
{{- if .Has "auth"}}
	Password  string    `bun:"password,notnull"      validate:"required,min=8"                                  json:"-"`
{{- end}}
	CreatedAt time.Time `bun:"created_at,nullzero,notnull,default:current_timestamp"                            json:"created_at"`
	UpdatedAt time.Time `bun:"updated_at,nullzero,notnull,default:current_timestamp"                            json:"updated_at"`
}

// APIError is the standard JSON error envelope returned by all endpoints.
// For validation failures, Errors contains per-field messages keyed by
// the JSON field name.
type APIError struct {
	Error   string            `json:"error"             example:"validation failed"`
	Details map[string]string `json:"details,omitempty"`
}
