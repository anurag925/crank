package database

import (
	"testing"

	"{{.ModulePath}}/internal/config"

	"github.com/stretchr/testify/assert"
)

func TestDatabaseConfig_DSN(t *testing.T) {
	cfg := config.DatabaseConfig{
		Host:     "localhost",
		Port:     5432,
		User:     "postgres",
		Password: "secret",
		Name:     "mydb",
		SSLMode:  "disable",
	}

	dsn := cfg.DSN()

	assert.Contains(t, dsn, "postgres://postgres:secret@localhost:5432/mydb")
	assert.Contains(t, dsn, "sslmode=disable")
}

func TestMigrateUp_EmptyURL(t *testing.T) {
	err := MigrateUp("", "migrations")
	assert.Error(t, err)
	assert.Contains(t, err.Error(), "database URL is required")
}

func TestMigrateDown_EmptyURL(t *testing.T) {
	err := MigrateDown("", "migrations")
	assert.Error(t, err)
	assert.Contains(t, err.Error(), "database URL is required")
}
