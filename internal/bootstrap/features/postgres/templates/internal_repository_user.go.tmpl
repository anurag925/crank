package repository

import (
	"context"
	"database/sql"
	"errors"

	"github.com/uptrace/bun"

	"{{.ModulePath}}/internal/model"
)

// ErrUserNotFound is returned by the repository when a lookup fails.
var ErrUserNotFound = errors.New("user not found")

// UserRepository provides CRUD access to users backed by PostgreSQL via Bun.
type UserRepository struct {
	db *bun.DB
}

// NewUserRepository constructs a Bun-backed UserRepository.
func NewUserRepository(db *bun.DB) *UserRepository {
	return &UserRepository{db: db}
}

// List returns every user in the table.
func (r *UserRepository) List(ctx context.Context) ([]model.User, error) {
	var users []model.User
	if err := r.db.NewSelect().Model(&users).OrderExpr("id ASC").Scan(ctx); err != nil {
		return nil, err
	}
	return users, nil
}

// Get returns a user by primary key.
func (r *UserRepository) Get(ctx context.Context, id int64) (model.User, error) {
	u := new(model.User)
	err := r.db.NewSelect().Model(u).Where("id = ?", id).Scan(ctx)
	if errors.Is(err, sql.ErrNoRows) {
		return model.User{}, ErrUserNotFound
	}
	if err != nil {
		return model.User{}, err
	}
	return *u, nil
}

// GetByEmail returns a user by their email address.
func (r *UserRepository) GetByEmail(ctx context.Context, email string) (model.User, error) {
	u := new(model.User)
	err := r.db.NewSelect().Model(u).Where("email = ?", email).Scan(ctx)
	if errors.Is(err, sql.ErrNoRows) {
		return model.User{}, ErrUserNotFound
	}
	if err != nil {
		return model.User{}, err
	}
	return *u, nil
}

// Create inserts a new user and fills in the auto-generated id/timestamps.
func (r *UserRepository) Create(ctx context.Context, u *model.User) error {
	_, err := r.db.NewInsert().Model(u).Returning("id", "created_at", "updated_at").Exec(ctx)
	return err
}
