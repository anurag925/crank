package workflow

import (
	"time"

	"go.temporal.io/sdk/workflow"

	"{{.ModulePath}}/internal/activity"
)

// GreetingWorkflow is an example Temporal workflow. It invokes the Greet
// activity and returns the resulting greeting. Both the workflow and activity
// log through the SDK loggers, which the worker bridges to the app's slog logger.
func GreetingWorkflow(ctx workflow.Context, name string) (string, error) {
	logger := workflow.GetLogger(ctx)
	logger.Info("GreetingWorkflow started", "name", name)

	ctx = workflow.WithActivityOptions(ctx, workflow.ActivityOptions{
		StartToCloseTimeout: 30 * time.Second,
	})

	var greeting string
	if err := workflow.ExecuteActivity(ctx, activity.Greet, activity.GreetingInput{Name: name}).Get(ctx, &greeting); err != nil {
		logger.Error("greeting activity failed", "error", err)
		return "", err
	}

	logger.Info("GreetingWorkflow completed", "greeting", greeting)
	return greeting, nil
}
