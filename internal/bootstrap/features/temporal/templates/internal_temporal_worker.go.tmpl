package temporal

import (
	"go.temporal.io/sdk/client"
	"go.temporal.io/sdk/worker"

	"{{.ModulePath}}/internal/config"

	"{{.ModulePath}}/internal/activity"
	"{{.ModulePath}}/internal/workflow"
)

// NewWorker creates a Temporal worker bound to the configured task queue and
// registers every workflow and activity in the project.
//
// Workflows and activities generated with `crank make workflow|activity` are
// wired in automatically at the marker comments below — do not remove them.
func NewWorker(c client.Client, cfg config.TemporalConfig) worker.Worker {
	w := worker.New(c, cfg.TaskQueue, worker.Options{})
	registerWorkflows(w)
	registerActivities(w)
	return w
}

// registerWorkflows registers all workflow functions with the worker.
func registerWorkflows(w worker.Worker) {
	w.RegisterWorkflow(workflow.GreetingWorkflow)
	// crank:workflow-register
}

// registerActivities registers all activity functions with the worker.
func registerActivities(w worker.Worker) {
	w.RegisterActivity(activity.Greet)
	// crank:activity-register
}
