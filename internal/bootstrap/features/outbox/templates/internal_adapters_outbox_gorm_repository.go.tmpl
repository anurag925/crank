package gorm

import (
	"context"
	"errors"
	"time"

	"gorm.io/gorm"

	"{{.ModulePath}}/internal/domain/outbox"
)

// outboxRow is the postgres row DTO for the outbox_events table. It is
// intentionally private to this adapter: callers work with the
// domain/outbox.Event value object.
type outboxRow struct {
	ID          string     `gorm:"column:id;primaryKey;type:uuid"`
	AggregateID string     `gorm:"column:aggregate_id;not null"`
	EventType   string     `gorm:"column:event_type;not null"`
	Payload     []byte     `gorm:"column:payload;not null"`
	CreatedAt   time.Time  `gorm:"column:created_at;not null;default:current_timestamp"`
	PublishedAt *time.Time `gorm:"column:published_at"`
}

// TableName tells GORM to use the outbox_events table for this model.
func (outboxRow) TableName() string {
	return "outbox_events"
}

func (r *outboxRow) toDomain() *outbox.Event {
	return &outbox.Event{
		ID:          r.ID,
		AggregateID: r.AggregateID,
		EventType:   r.EventType,
		Payload:     r.Payload,
		CreatedAt:   r.CreatedAt,
		PublishedAt: r.PublishedAt,
	}
}

// OutboxRepository is the postgres-backed implementation of
// domain/outbox.Repository.
type OutboxRepository struct {
	db *gorm.DB
}

// NewOutboxRepository returns a GORM-backed OutboxRepository.
func NewOutboxRepository(db *gorm.DB) *OutboxRepository {
	return &OutboxRepository{db: db}
}

// Append inserts a new outbox row. The caller is expected to be inside
// the same transaction as the aggregate Save.
func (r *OutboxRepository) Append(ctx context.Context, e *outbox.Event) error {
	row := &outboxRow{
		ID:          e.ID,
		AggregateID: e.AggregateID,
		EventType:   e.EventType,
		Payload:     e.Payload,
	}
	return r.db.WithContext(ctx).Create(row).Error
}

// FetchUnpublished returns the oldest unpublished events up to the given
// limit, ordered by created_at so workers process events in the order
// they were recorded.
func (r *OutboxRepository) FetchUnpublished(ctx context.Context, limit int) ([]*outbox.Event, error) {
	var rows []outboxRow
	err := r.db.WithContext(ctx).
		Where("published_at IS NULL").
		Order("created_at ASC").
		Limit(limit).
		Find(&rows).Error
	if err != nil {
		return nil, err
	}
	out := make([]*outbox.Event, 0, len(rows))
	for i := range rows {
		out = append(out, rows[i].toDomain())
	}
	return out, nil
}

// MarkPublished stamps PublishedAt on the supplied row ids. Rows that are
// missing or already published are ignored.
func (r *OutboxRepository) MarkPublished(ctx context.Context, ids []string) error {
	if len(ids) == 0 {
		return nil
	}
	now := time.Now().UTC()
	err := r.db.WithContext(ctx).
		Model(&outboxRow{}).
		Where("id IN ?", ids).
		Update("published_at", now).Error
	if errors.Is(err, gorm.ErrRecordNotFound) {
		return nil
	}
	return err
}
