// Package outbox provides the postgres-backed UnitOfWork implementation
// that powers the transactional outbox pattern. The unit of work wraps
// the application's save closure in a database transaction so the
// aggregate write and the outbox row commit (or roll back) atomically.
package outbox

import (
	"context"
	"fmt"

	"github.com/google/uuid"
	"gorm.io/gorm"

	"{{.ModulePath}}/internal/application/uow"
	gormadapter "{{.ModulePath}}/internal/adapters/persistence/gorm"
	"{{.ModulePath}}/internal/domain/outbox"
	"{{.ModulePath}}/internal/domain/shared"
	"{{.ModulePath}}/internal/domain/user"
	// crank:tx-repo-imports (do not remove — `crank make scaffold` splices new domain imports here)
)

// txRepositories implements uow.TxRepositories by constructing
// GORM-backed adapters from the active transaction. Every accessor
// returns a repository that participates in the same database
// transaction, so all writes in the save closure plus the outbox
// append are committed (or rolled back) atomically.
type txRepositories struct {
	tx *gorm.DB
}

var _ uow.TxRepositories = (*txRepositories)(nil)

func (r *txRepositories) Users() user.Repository {
	return gormadapter.NewUserRepository(r.tx)
}

// crank:tx-repo-methods (do not remove — `crank make scaffold` splices new repo accessor methods here)

// GormUoW is a transactional UnitOfWork backed by the outbox_events
// table. SaveAndPublish runs the supplied save closure in a GORM-managed
// transaction via TxRepositories; on success it appends one outbox row per
// event and the transaction commits, atomically recording the aggregate
// write and the events it produced. The event bus is *not* invoked here —
// the worker drains the outbox and publishes to the bus asynchronously.
type GormUoW struct {
	db *gorm.DB
}

// NewGormUoW constructs a GormUoW that runs the save closure in a
// transaction on the supplied *gorm.DB.
func NewGormUoW(db *gorm.DB) *GormUoW {
	return &GormUoW{db: db}
}

var _ uow.UnitOfWork = (*GormUoW)(nil)

// SaveAndPublish runs save(ctx, repos) in a transaction through
// TxRepositories; on success it appends one outbox row per event. Any
// error from save or from the append causes the transaction to roll back.
func (u *GormUoW) SaveAndPublish(ctx context.Context, save func(ctx context.Context, repos uow.TxRepositories) error, events []shared.DomainEvent) error {
	return u.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
		if err := save(ctx, &txRepositories{tx: tx}); err != nil {
			return err
		}
		for _, ev := range events {
			payload, err := shared.EncodeEvent(ev)
			if err != nil {
				return fmt.Errorf("encode event %q: %w", ev.EventName(), err)
			}
			row := &outbox.Event{
				ID:          uuid.NewString(),
				AggregateID: aggregateIDFromEvent(ev),
				EventType:   ev.EventName(),
				Payload:     payload,
			}
			outboxRepo := gormadapter.NewOutboxRepository(tx)
			if err := outboxRepo.Append(ctx, row); err != nil {
				return fmt.Errorf("append outbox event: %w", err)
			}
		}
		return nil
	})
}

// aggregateIDFromEvent best-effort extracts an aggregate id from the
// event's JSON-marshaled body. If the body is empty or the id cannot be
// determined, the row's aggregate_id is left as the event name so the
// table stays queryable.
func aggregateIDFromEvent(ev shared.DomainEvent) string {
	body, err := shared.EncodeEvent(ev)
	if err != nil || len(body) == 0 {
		return ev.EventName()
	}
	return string(body)
}
