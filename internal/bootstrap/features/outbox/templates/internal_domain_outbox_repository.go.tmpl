// Package outbox defines the domain types for the transactional outbox
// pattern. Events are persisted in the same transaction as the aggregate
// that produced them; a background worker drains the outbox to the event
// bus so the two operations are no longer coupled to the application
// service's call stack.
package outbox

import "context"

// Repository is the port for the outbox table. The postgres feature
// provides the production implementation; tests can swap in an in-memory
// or fake repository.
type Repository interface {
	// Append inserts a new outbox row. The call is expected to run inside
	// the same transaction as the aggregate Save, so a rollback discards
	// both the aggregate write and the event.
	Append(ctx context.Context, e *Event) error

	// FetchUnpublished returns up to limit events that have not yet been
	// published to the bus, ordered by creation time so workers process
	// the oldest events first.
	FetchUnpublished(ctx context.Context, limit int) ([]*Event, error)

	// MarkPublished stamps PublishedAt on the rows, removing them from
	// the worker's view.
	MarkPublished(ctx context.Context, ids []string) error
}
