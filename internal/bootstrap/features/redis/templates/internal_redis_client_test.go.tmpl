package redis

import (
	"testing"

	"github.com/stretchr/testify/assert"
)

func TestNewClient_ConnectionRefused(t *testing.T) {
	cfg := Config{
		Addr:     "localhost:63999",
		Password: "",
		DB:       0,
	}

	// Without a running Redis server on port 63999, this should fail.
	_, err := NewClient(cfg)
	assert.Error(t, err)
}

func TestConfig_Fields(t *testing.T) {
	cfg := Config{
		Addr:     "localhost:6379",
		Password: "secret",
		DB:       1,
	}

	assert.Equal(t, "localhost:6379", cfg.Addr)
	assert.Equal(t, "secret", cfg.Password)
	assert.Equal(t, 1, cfg.DB)
}
