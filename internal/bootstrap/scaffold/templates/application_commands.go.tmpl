package {{.R.Snake}}
{{- if or .HasTime .HasUUID}}

import (
{{- if .HasTime}}
	"time"
{{- end}}
{{- if .HasUUID}}
	"github.com/google/uuid"
{{- end}}
)
{{- end}}

// Create{{.R.Pascal}}Command is the application-layer request to create a new
// {{.R.Snake}}. The CommandHandler parses the stringly-typed ID into a
// uuid.UUID before constructing the aggregate.
type Create{{.R.Pascal}}Command struct {
	ID string
{{- range .Fields}}
	{{.GoName}} {{.GoType}}
{{- end}}
}

// Update{{.R.Pascal}}Command is the application-layer request to mutate an
// existing {{.R.Snake}}. The CommandHandler loads the aggregate by ID, calls
// Update, and persists the result.
type Update{{.R.Pascal}}Command struct {
	ID string
{{- range .Fields}}
	{{.GoName}} {{.GoType}}
{{- end}}
}

// Delete{{.R.Pascal}}Command is the application-layer request to remove a
// {{.R.Snake}}.
type Delete{{.R.Pascal}}Command struct {
	ID string
}
{{- if and .Auth (eq .R.Pascal "User")}}

// Authenticate{{.R.Pascal}}Command is the application-layer request to verify
// a {{.R.Snake}}'s email/password credentials during login.
type Authenticate{{.R.Pascal}}Command struct {
	Email    string
	Password string
}
{{- end}}
