package repository

import (
{{- if .Postgres}}
	"context"
	"database/sql"
	"errors"

	"github.com/uptrace/bun"

	"{{.Module}}/internal/model"
{{- else}}
	"context"
	"errors"
	"sync"
	"sync/atomic"

	"{{.Module}}/internal/model"
{{- end}}
)

// Err{{.R.Pascal}}NotFound is returned when a {{.R.Snake}} lookup fails.
var Err{{.R.Pascal}}NotFound = errors.New("{{.R.Snake}} not found")

{{if .Postgres -}}
// {{.R.Pascal}}Repository provides CRUD access to {{.R.SnakePlural}} backed by PostgreSQL via Bun.
type {{.R.Pascal}}Repository struct {
	db *bun.DB
}

// New{{.R.Pascal}}Repository constructs a Bun-backed {{.R.Pascal}}Repository.
func New{{.R.Pascal}}Repository(db *bun.DB) *{{.R.Pascal}}Repository {
	return &{{.R.Pascal}}Repository{db: db}
}

// List returns every {{.R.Snake}} ordered by id.
func ({{.R.Receiver}} *{{.R.Pascal}}Repository) List(ctx context.Context) ([]model.{{.R.Pascal}}, error) {
	var items []model.{{.R.Pascal}}
	if err := {{.R.Receiver}}.db.NewSelect().Model(&items).OrderExpr("id ASC").Scan(ctx); err != nil {
		return nil, err
	}
	return items, nil
}

// Get returns a {{.R.Snake}} by primary key.
func ({{.R.Receiver}} *{{.R.Pascal}}Repository) Get(ctx context.Context, id int64) (model.{{.R.Pascal}}, error) {
	m := new(model.{{.R.Pascal}})
	err := {{.R.Receiver}}.db.NewSelect().Model(m).Where("id = ?", id).Scan(ctx)
	if errors.Is(err, sql.ErrNoRows) {
		return model.{{.R.Pascal}}{}, Err{{.R.Pascal}}NotFound
	}
	if err != nil {
		return model.{{.R.Pascal}}{}, err
	}
	return *m, nil
}

// Create inserts a new {{.R.Snake}} and fills in the generated id/timestamps.
func ({{.R.Receiver}} *{{.R.Pascal}}Repository) Create(ctx context.Context, m *model.{{.R.Pascal}}) error {
	_, err := {{.R.Receiver}}.db.NewInsert().Model(m).Returning("id", "created_at", "updated_at").Exec(ctx)
	return err
}

// Update persists changes to an existing {{.R.Snake}}.
func ({{.R.Receiver}} *{{.R.Pascal}}Repository) Update(ctx context.Context, m *model.{{.R.Pascal}}) error {
	res, err := {{.R.Receiver}}.db.NewUpdate().
		Model(m).
		Set("updated_at = current_timestamp").
		WherePK().
		OmitZero().
		Exec(ctx)
	if err != nil {
		return err
	}
	if n, _ := res.RowsAffected(); n == 0 {
		return Err{{.R.Pascal}}NotFound
	}
	return nil
}

// Delete removes a {{.R.Snake}} by primary key.
func ({{.R.Receiver}} *{{.R.Pascal}}Repository) Delete(ctx context.Context, id int64) error {
	res, err := {{.R.Receiver}}.db.NewDelete().Model((*model.{{.R.Pascal}})(nil)).Where("id = ?", id).Exec(ctx)
	if err != nil {
		return err
	}
	if n, _ := res.RowsAffected(); n == 0 {
		return Err{{.R.Pascal}}NotFound
	}
	return nil
}
{{- else -}}
// {{.R.Pascal}}Repository is an in-memory {{.R.Snake}} store. Swap it for a database-backed
// implementation (e.g. add the postgres feature) when you need persistence.
type {{.R.Pascal}}Repository struct {
	mu     sync.RWMutex
	nextID int64
	items  map[int64]model.{{.R.Pascal}}
}

// New{{.R.Pascal}}Repository constructs an in-memory {{.R.Pascal}}Repository.
func New{{.R.Pascal}}Repository() *{{.R.Pascal}}Repository {
	return &{{.R.Pascal}}Repository{items: make(map[int64]model.{{.R.Pascal}})}
}

// List returns every {{.R.Snake}}.
func ({{.R.Receiver}} *{{.R.Pascal}}Repository) List(ctx context.Context) ([]model.{{.R.Pascal}}, error) {
	{{.R.Receiver}}.mu.RLock()
	defer {{.R.Receiver}}.mu.RUnlock()
	out := make([]model.{{.R.Pascal}}, 0, len({{.R.Receiver}}.items))
	for _, m := range {{.R.Receiver}}.items {
		out = append(out, m)
	}
	return out, nil
}

// Get returns a {{.R.Snake}} by id.
func ({{.R.Receiver}} *{{.R.Pascal}}Repository) Get(ctx context.Context, id int64) (model.{{.R.Pascal}}, error) {
	{{.R.Receiver}}.mu.RLock()
	defer {{.R.Receiver}}.mu.RUnlock()
	m, ok := {{.R.Receiver}}.items[id]
	if !ok {
		return model.{{.R.Pascal}}{}, Err{{.R.Pascal}}NotFound
	}
	return m, nil
}

// Create stores a new {{.R.Snake}} and assigns it an id.
func ({{.R.Receiver}} *{{.R.Pascal}}Repository) Create(ctx context.Context, m *model.{{.R.Pascal}}) error {
	{{.R.Receiver}}.mu.Lock()
	defer {{.R.Receiver}}.mu.Unlock()
	m.ID = atomic.AddInt64(&{{.R.Receiver}}.nextID, 1)
	{{.R.Receiver}}.items[m.ID] = *m
	return nil
}

// Update replaces an existing {{.R.Snake}}.
func ({{.R.Receiver}} *{{.R.Pascal}}Repository) Update(ctx context.Context, m *model.{{.R.Pascal}}) error {
	{{.R.Receiver}}.mu.Lock()
	defer {{.R.Receiver}}.mu.Unlock()
	if _, ok := {{.R.Receiver}}.items[m.ID]; !ok {
		return Err{{.R.Pascal}}NotFound
	}
	{{.R.Receiver}}.items[m.ID] = *m
	return nil
}

// Delete removes a {{.R.Snake}} by id.
func ({{.R.Receiver}} *{{.R.Pascal}}Repository) Delete(ctx context.Context, id int64) error {
	{{.R.Receiver}}.mu.Lock()
	defer {{.R.Receiver}}.mu.Unlock()
	if _, ok := {{.R.Receiver}}.items[id]; !ok {
		return Err{{.R.Pascal}}NotFound
	}
	delete({{.R.Receiver}}.items, id)
	return nil
}
{{- end}}
