func TestNew{{.R.Pascal}}ID_RejectsEmpty(t *testing.T) {
	_, err := New{{.R.Pascal}}ID("")
	assert.ErrorIs(t, err, ErrInvalid{{.R.Pascal}}ID)
}

func Test{{.R.Pascal}}ID_IsZero(t *testing.T) {
	var zero {{.R.Pascal}}ID
