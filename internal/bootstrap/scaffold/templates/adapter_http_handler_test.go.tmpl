// new{{.R.Pascal}}TestEcho returns an Echo instance wired with the validating
// binder so handler tests exercise the same binding/validation path as
// production.
func new{{.R.Pascal}}TestEcho() *echo.Echo {
	e := echo.New()
	e.HideBanner = true
	e.Binder = &echoBinder{defaultBinder: new(echo.DefaultBinder)}
	return e
}

// new{{.R.Pascal}}Handler wires a {{.R.Pascal}}Handler against an in-memory
// repository and a nil event bus. The handler skips publishing when the bus
// is nil.
func new{{.R.Pascal}}Handler() *{{.R.Pascal}}Handler {
	repo := memory.New{{.R.Pascal}}Repository()
	cmd := app{{.R.Pascal}}.NewCommandHandler(repo, nil)
	qry := app{{.R.Pascal}}.NewQueryHandler(repo)
	return New{{.R.Pascal}}Handler(cmd, qry)
}

// sample{{.R.Pascal}}DTO builds a {{.R.Snake}} DTO whose fields satisfy the
// DTO's validation rules.
func sample{{.R.Pascal}}DTO() {{.R.Snake}}DTO {
	return {{.R.Snake}}DTO{
		ID: "123e4567-e89b-12d3-a456-426614174000",{{range .Fields}}
		{{.GoName}}: {{.Sample}},{{end}}
	}
}

func Test{{.R.Pascal}}Handler_Routes(t *testing.T) {
	e := new{{.R.Pascal}}TestEcho()
	g := e.Group("/{{.R.KebabPlural}}")
	new{{.R.Pascal}}Handler().Register(g)

	routes := map[string]bool{}
	for _, r := range e.Routes() {
		routes[r.Method+" "+r.Path] = true
	}
	assert.True(t, routes["GET /{{.R.KebabPlural}}"], "list route should exist")
	assert.True(t, routes["POST /{{.R.KebabPlural}}"], "create route should exist")
	assert.True(t, routes["GET /{{.R.KebabPlural}}/:id"], "get route should exist")
	assert.True(t, routes["PUT /{{.R.KebabPlural}}/:id"], "update route should exist")
	assert.True(t, routes["DELETE /{{.R.KebabPlural}}/:id"], "delete route should exist")
}

func Test{{.R.Pascal}}Handler_ListEmpty(t *testing.T) {
	e := new{{.R.Pascal}}TestEcho()
	req := httptest.NewRequest(http.MethodGet, "/{{.R.KebabPlural}}", nil)
	rec := httptest.NewRecorder()

	_ = e.Group("/{{.R.KebabPlural}}")
	h := new{{.R.Pascal}}Handler()
	require.NoError(t, h.List(e.NewContext(req, rec)))
}

func Test{{.R.Pascal}}Handler_CreateAndGet(t *testing.T) {
	e := new{{.R.Pascal}}TestEcho()
	_ = e.Group("/{{.R.KebabPlural}}")
	h := new{{.R.Pascal}}Handler()

	body, err := json.Marshal(sample{{.R.Pascal}}DTO())
	require.NoError(t, err)

	createReq := httptest.NewRequest(http.MethodPost, "/{{.R.KebabPlural}}", bytes.NewReader(body))
	createReq.Header.Set(echo.HeaderContentType, echo.MIMEApplicationJSON)
	createRec := httptest.NewRecorder()
	c := e.NewContext(createReq, createRec)
	c.SetPath("/{{.R.KebabPlural}}")
	require.NoError(t, h.Create(c))
	assert.Equal(t, http.StatusCreated, createRec.Code)

	getReq := httptest.NewRequest(http.MethodGet, "/", nil)
	getRec := httptest.NewRecorder()
	gc := e.NewContext(getReq, getRec)
	gc.SetPath("/{{.R.KebabPlural}}/:id")
	gc.SetParamNames("id")
	gc.SetParamValues("123e4567-e89b-12d3-a456-426614174000")
	require.NoError(t, h.Get(gc))
	assert.Equal(t, http.StatusOK, getRec.Code)
}

func Test{{.R.Pascal}}Handler_GetNotFound(t *testing.T) {
	e := new{{.R.Pascal}}TestEcho()
	req := httptest.NewRequest(http.MethodGet, "/", nil)
	rec := httptest.NewRecorder()
	c := e.NewContext(req, rec)
	c.SetPath("/{{.R.KebabPlural}}/:id")
	c.SetParamNames("id")
	c.SetParamValues("123e4567-e89b-12d3-a456-426614174000")

	h := new{{.R.Pascal}}Handler()
	require.NoError(t, h.Get(c))
	assert.Equal(t, http.StatusNotFound, rec.Code)
}

func Test{{.R.Pascal}}Handler_Delete(t *testing.T) {
	e := new{{.R.Pascal}}TestEcho()
	_ = e.Group("/{{.R.KebabPlural}}")
	h := new{{.R.Pascal}}Handler()

	body, err := json.Marshal(sample{{.R.Pascal}}DTO())
	require.NoError(t, err)

	createReq := httptest.NewRequest(http.MethodPost, "/{{.R.KebabPlural}}", bytes.NewReader(body))
	createReq.Header.Set(echo.HeaderContentType, echo.MIMEApplicationJSON)
	createRec := httptest.NewRecorder()
	cc := e.NewContext(createReq, createRec)
	cc.SetPath("/{{.R.KebabPlural}}")
	require.NoError(t, h.Create(cc))
	require.Equal(t, http.StatusCreated, createRec.Code)

	delReq := httptest.NewRequest(http.MethodDelete, "/", nil)
	delRec := httptest.NewRecorder()
	dc := e.NewContext(delReq, delRec)
	dc.SetPath("/{{.R.KebabPlural}}/:id")
	dc.SetParamNames("id")
	dc.SetParamValues("123e4567-e89b-12d3-a456-426614174000")
	require.NoError(t, h.Delete(dc))
	assert.Equal(t, http.StatusNoContent, delRec.Code)
}
