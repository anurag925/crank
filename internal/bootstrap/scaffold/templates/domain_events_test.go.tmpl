func Test{{.R.Pascal}}Created_EventName(t *testing.T) {
	now := time.Now().UTC()
	e := {{.R.Pascal}}Created{ID: uuid.MustParse("123e4567-e89b-12d3-a456-426614174000"), occurredAt: now}
	assert.Equal(t, "{{.R.Snake}}.created", e.EventName())
	assert.Equal(t, now, e.OccurredAt())
}

