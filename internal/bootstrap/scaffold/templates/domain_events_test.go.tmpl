func Test{{.R.Pascal}}_Events_ImplementDomainEvent(t *testing.T) {
	now := time.Now().UTC()
	var _ interface {
		EventName() string
		OccurredAt() time.Time
	} = {{.R.Pascal}}Created{ID: uuid.MustParse("00000000-0000-0000-0000-000000000001"), occurredAt: now}
	var _ interface {
		EventName() string
		OccurredAt() time.Time
	} = {{.R.Pascal}}Updated{ID: uuid.MustParse("00000000-0000-0000-0000-000000000001"), occurredAt: now}
	var _ interface {
		EventName() string
		OccurredAt() time.Time
	} = {{.R.Pascal}}Deleted{ID: uuid.MustParse("00000000-0000-0000-0000-000000000001"), occurredAt: now}
	require.True(t, true)
}
