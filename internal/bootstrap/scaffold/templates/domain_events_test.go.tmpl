func Test{{.R.Pascal}}_Events_ImplementDomainEvent(t *testing.T) {
	now := time.Now().UTC()
	var _ interface {
		EventName() string
		OccurredAt() time.Time
	} = {{.R.Pascal}}Created{ {{.R.Pascal}}ID: "x", occurredAt: now}
	var _ interface {
		EventName() string
		OccurredAt() time.Time
	} = {{.R.Pascal}}Updated{ {{.R.Pascal}}ID: "x", occurredAt: now}
	var _ interface {
