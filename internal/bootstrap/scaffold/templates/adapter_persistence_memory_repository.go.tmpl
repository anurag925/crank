func (r *{{.R.Pascal}}Repository) Get(_ context.Context, id uuid.UUID) (*{{.R.Snake}}.{{.R.Pascal}}, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()
	x, ok := r.items[id]
	if !ok {
