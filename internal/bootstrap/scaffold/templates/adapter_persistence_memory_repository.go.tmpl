	}
	return x, nil
}

// List returns every stored {{.R.Snake}} aggregate, in insertion order.
func (r *{{.R.Pascal}}Repository) List(_ context.Context) ([]*{{.R.Snake}}.{{.R.Pascal}}, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()
	out := make([]*{{.R.Snake}}.{{.R.Pascal}}, 0, len(r.items))
	for _, x := range r.items {
