// {{.R.Snake}}DTO is the input/output DTO for {{.R.Snake}} HTTP endpoints. The
// HTTP layer owns validation tags; the domain aggregate stays tag-free.
type {{.R.Snake}}DTO struct {
	ID string `json:"id" validate:"required,uuid"`
{{- range .Fields}}
	{{.GoName}} {{.GoType}} `json:"{{.Name}}"{{if .Validate}} validate:"{{.Validate}}"{{end}}`
{{- end}}
}

// toCreateCommand converts the DTO to an application Create command.
func (d {{.R.Snake}}DTO) toCreateCommand() app{{.R.Pascal}}.Create{{.R.Pascal}}Command {
	return app{{.R.Pascal}}.Create{{.R.Pascal}}Command{
		ID: d.ID,
{{- range .Fields}}
		{{.GoName}}: d.{{.GoName}},
{{- end}}
	}
}

// toUpdateCommand converts the DTO to an application Update command.
func (d {{.R.Snake}}DTO) toUpdateCommand() app{{.R.Pascal}}.Update{{.R.Pascal}}Command {
	return app{{.R.Pascal}}.Update{{.R.Pascal}}Command{
		ID: d.ID,
{{- range .Fields}}
		{{.GoName}}: d.{{.GoName}},
{{- end}}
	}
}

// toDTO projects a domain aggregate onto the response DTO shape.
func to{{.R.Pascal}}DTO(x *{{.R.Snake}}.{{.R.Pascal}}) {{.R.Snake}}DTO {
	return {{.R.Snake}}DTO{
		ID: x.ID().String(),
{{- range .Fields}}
		{{.GoName}}: x.{{.GoName}}(),
{{- end}}
	}
}

// {{.R.Pascal}}Handler exposes CRUD HTTP endpoints for {{.R.SnakePlural}}. It
// depends only on the application-layer command/query handlers; the domain
// package is reachable only through their typed return values.
type {{.R.Pascal}}Handler struct {
	cmd *app{{.R.Pascal}}.CommandHandler
	qry *app{{.R.Pascal}}.QueryHandler
}

// New{{.R.Pascal}}Handler builds a {{.R.Pascal}}Handler wired to the given
// application services.
func New{{.R.Pascal}}Handler(cmd *app{{.R.Pascal}}.CommandHandler, qry *app{{.R.Pascal}}.QueryHandler) *{{.R.Pascal}}Handler {
	return &{{.R.Pascal}}Handler{cmd: cmd, qry: qry}
}

// Register attaches {{.R.Snake}} routes to the supplied Echo group. The group
// prefix is owned by the caller (the central routes aggregator mounts the
// resource under /{{.R.KebabPlural}}).
func (h *{{.R.Pascal}}Handler) Register(g *echo.Group) {
	g.POST("", h.Create)
	g.GET("/:id", h.Get)
	g.GET("", h.List)
	g.PUT("/:id", h.Update)
	g.DELETE("/:id", h.Delete)
}

// Create godoc
//
//	@Summary      Create a {{.R.Snake}}
//	@Description  Creates a new {{.R.Snake}}.
//	@Tags         {{.R.SnakePlural}}
//	@Accept       json
//	@Produce      json
//	@Param        {{.R.Snake}}  body      {{.R.Snake}}DTO  true  "{{.R.Pascal}} payload"
//	@Success      201   {object}  {{.R.Snake}}DTO
//	@Failure      422   {object}  model.APIError
//	@Router       /{{.R.KebabPlural}} [post]
func (h *{{.R.Pascal}}Handler) Create(c echo.Context) error {
	var in {{.R.Snake}}DTO
	if err := c.Bind(&in); err != nil {
		return c.JSON(http.StatusBadRequest, model.APIError{Error: err.Error()})
	}
	out, err := h.cmd.HandleCreate(c.Request().Context(), in.toCreateCommand())
	if errors.Is(err, {{.R.Snake}}.Err{{.R.Pascal}}NotFound) {
		return c.JSON(http.StatusNotFound, model.APIError{Error: "{{.R.Snake}} not found"})
	}
	if err != nil {
		return c.JSON(http.StatusUnprocessableEntity, model.APIError{Error: err.Error()})
	}
	return c.JSON(http.StatusCreated, to{{.R.Pascal}}DTO(out))
}

// Get godoc
//
//	@Summary      Get a {{.R.Snake}}
//	@Description  Returns a single {{.R.Snake}} by ID.
