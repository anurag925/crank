package v1

import (
	"errors"
	"net/http"

{{- if .HasUUID}}
	"github.com/google/uuid"
{{- end}}
	"github.com/labstack/echo/v5"

	"{{.Module}}/internal/adapters/http/web/api"
	app{{.R.Pascal}} "{{.Module}}/internal/application/{{.R.Snake}}"
	"{{.Module}}/internal/domain/{{.R.Snake}}"
)

// {{.R.Snake}}DTO is the input/output DTO for {{.R.Snake}} HTTP endpoints.
// The HTTP DTO owns validation tags and string-serialized IDs.
type {{.R.Snake}}DTO struct {
	ID string `json:"id" validate:"omitempty,uuid"`
{{- range .Fields}}
	{{.GoName}} {{.DTOGoType}} `json:"{{.Name}}"{{if .Validate}} validate:"{{.Validate}}"{{end}}`
{{- end}}
}

// toCreateCommand converts the DTO to an application Create command.
// UUID-typed DTO fields are parsed from string to uuid.UUID for the command layer.
func (d {{.R.Snake}}DTO) toCreateCommand() app{{.R.Pascal}}.Create{{.R.Pascal}}Command {
	return app{{.R.Pascal}}.Create{{.R.Pascal}}Command{
		ID: d.ID,
{{- range .Fields}}
		{{.GoName}}: {{if .IsUUID}}uuid.MustParse(d.{{.GoName}}){{else}}d.{{.GoName}}{{end}},
{{- end}}
	}
}

// toUpdateCommand converts the DTO to an application Update command.
func (d {{.R.Snake}}DTO) toUpdateCommand() app{{.R.Pascal}}.Update{{.R.Pascal}}Command {
	return app{{.R.Pascal}}.Update{{.R.Pascal}}Command{
		ID: d.ID,
{{- range .Fields}}
		{{.GoName}}: {{if .IsUUID}}uuid.MustParse(d.{{.GoName}}){{else}}d.{{.GoName}}{{end}},
{{- end}}
	}
}

// toDTO projects a domain aggregate onto the response DTO shape.
func to{{.R.Pascal}}DTO(x *{{.R.Snake}}.{{.R.Pascal}}) {{.R.Snake}}DTO {
	return {{.R.Snake}}DTO{
		ID: x.ID.String(),
{{- range .Fields}}
		{{.GoName}}: {{if .IsUUID}}x.{{.GoName}}.String(){{else}}x.{{.GoName}}{{end}},
{{- end}}
	}
}

// {{.R.Pascal}}Handler exposes CRUD HTTP endpoints for {{.R.SnakePlural}}. It
// depends only on the application-layer command/query handlers; the domain
// package is reachable only through their typed return values.
type {{.R.Pascal}}Handler struct {
	cmd *app{{.R.Pascal}}.CommandHandler
	qry *app{{.R.Pascal}}.QueryHandler
}

// New{{.R.Pascal}}Handler builds a {{.R.Pascal}}Handler wired to the given
// application services.
func New{{.R.Pascal}}Handler(cmd *app{{.R.Pascal}}.CommandHandler, qry *app{{.R.Pascal}}.QueryHandler) *{{.R.Pascal}}Handler {
	return &{{.R.Pascal}}Handler{cmd: cmd, qry: qry}
}

// Register attaches {{.R.Snake}} routes to the supplied Echo group.
func (h *{{.R.Pascal}}Handler) Register(g *echo.Group) {
	g.POST("", h.Create)
	g.GET("/:id", h.Get)
	g.GET("", h.List)
	g.PUT("/:id", h.Update)
	g.DELETE("/:id", h.Delete)
}

// Create godoc
//
//	@Summary      Create a {{.R.Snake}}
//	@Description  Creates a new {{.R.Snake}}.
//	@Tags         {{.R.SnakePlural}}
//	@Accept       json
//	@Produce      json
//	@Param        {{.R.Snake}}  body      {{.R.Snake}}DTO  true  "{{.R.Pascal}} payload"
//	@Success      201   {object}  {{.R.Snake}}DTO
//	@Failure      422   {object}  api.Error
//	@Router       /v1/{{.R.KebabPlural}} [post]
func (h *{{.R.Pascal}}Handler) Create(c *echo.Context) error {
	var in {{.R.Snake}}DTO
	if err := c.Bind(&in); err != nil {
		return c.JSON(http.StatusBadRequest, api.Error{Error: err.Error()})
	}
	out, err := h.cmd.HandleCreate(c.Request().Context(), in.toCreateCommand())
	if errors.Is(err, {{.R.Snake}}.Err{{.R.Pascal}}NotFound) {
		return c.JSON(http.StatusNotFound, api.Error{Error: "{{.R.Snake}} not found"})
	}
	if err != nil {
		return c.JSON(http.StatusUnprocessableEntity, api.Error{Error: err.Error()})
	}
	return c.JSON(http.StatusCreated, to{{.R.Pascal}}DTO(out))
}

// Get godoc
//
//	@Summary      Get a {{.R.Snake}}
//	@Description  Returns a single {{.R.Snake}} by ID.
//	@Tags         {{.R.SnakePlural}}
//	@Produce      json
//	@Param        id   path      string  true  "{{.R.Pascal}} ID"
//	@Success      200  {object}  {{.R.Snake}}DTO
//	@Failure      404  {object}  api.Error
//	@Router       /v1/{{.R.KebabPlural}}/{id} [get]
func (h *{{.R.Pascal}}Handler) Get(c *echo.Context) error {
	out, err := h.qry.HandleGet(c.Request().Context(), app{{.R.Pascal}}.Get{{.R.Pascal}}Query{ID: c.Param("id")})
	if errors.Is(err, {{.R.Snake}}.Err{{.R.Pascal}}NotFound) {
		return c.JSON(http.StatusNotFound, api.Error{Error: "{{.R.Snake}} not found"})
	}
	if err != nil {
		return c.JSON(http.StatusBadRequest, api.Error{Error: err.Error()})
	}
	return c.JSON(http.StatusOK, to{{.R.Pascal}}DTO(out))
}

// List godoc
//
//	@Summary      List {{.R.SnakePlural}}
//	@Description  Returns all {{.R.SnakePlural}}.
//	@Tags         {{.R.SnakePlural}}
//	@Produce      json
//	@Success      200  {array}   {{.R.Snake}}DTO
//	@Failure      500  {object}  api.Error
//	@Router       /v1/{{.R.KebabPlural}} [get]
func (h *{{.R.Pascal}}Handler) List(c *echo.Context) error {
	items, err := h.qry.HandleList(c.Request().Context(), app{{.R.Pascal}}.List{{.R.PascalPlural}}Query{})
	if err != nil {
		return c.JSON(http.StatusInternalServerError, api.Error{Error: err.Error()})
	}
	out := make([]{{.R.Snake}}DTO, 0, len(items))
	for _, x := range items {
		out = append(out, to{{.R.Pascal}}DTO(x))
	}
	return c.JSON(http.StatusOK, out)
}

// Update godoc
//
//	@Summary      Update a {{.R.Snake}}
//	@Description  Updates an existing {{.R.Snake}} by ID.
//	@Tags         {{.R.SnakePlural}}
//	@Accept       json
//	@Produce      json
//	@Param        id        path      string         true  "{{.R.Pascal}} ID"
//	@Param        {{.R.Snake}}  body      {{.R.Snake}}DTO  true  "{{.R.Pascal}} payload"
//	@Success      200  {object}  {{.R.Snake}}DTO
//	@Failure      404  {object}  api.Error
//	@Failure      422  {object}  api.Error
//	@Router       /v1/{{.R.KebabPlural}}/{id} [put]
func (h *{{.R.Pascal}}Handler) Update(c *echo.Context) error {
	var in {{.R.Snake}}DTO
	if err := c.Bind(&in); err != nil {
		return c.JSON(http.StatusBadRequest, api.Error{Error: err.Error()})
	}
	in.ID = c.Param("id")
	out, err := h.cmd.HandleUpdate(c.Request().Context(), in.toUpdateCommand())
	if errors.Is(err, {{.R.Snake}}.Err{{.R.Pascal}}NotFound) {
		return c.JSON(http.StatusNotFound, api.Error{Error: "{{.R.Snake}} not found"})
	}
	if err != nil {
		return c.JSON(http.StatusUnprocessableEntity, api.Error{Error: err.Error()})
	}
	return c.JSON(http.StatusOK, to{{.R.Pascal}}DTO(out))
}

// Delete godoc
//
//	@Summary      Delete a {{.R.Snake}}
//	@Description  Deletes a {{.R.Snake}} by ID.
//	@Tags         {{.R.SnakePlural}}
//	@Produce      json
//	@Param        id   path      string  true  "{{.R.Pascal}} ID"
//	@Success      204  "No Content"
//	@Failure      404  {object}  api.Error
//	@Router       /v1/{{.R.KebabPlural}}/{id} [delete]
func (h *{{.R.Pascal}}Handler) Delete(c *echo.Context) error {
	err := h.cmd.HandleDelete(c.Request().Context(), app{{.R.Pascal}}.Delete{{.R.Pascal}}Command{ID: c.Param("id")})
	if errors.Is(err, {{.R.Snake}}.Err{{.R.Pascal}}NotFound) {
