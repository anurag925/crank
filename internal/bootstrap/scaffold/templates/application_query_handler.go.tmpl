// QueryHandler is the application service that reads {{.R.Snake}} aggregates
// in response to Get/List queries. It depends only on the domain Repository
// port.
type QueryHandler struct {
	repo {{.R.Snake}}.Repository
}

// NewQueryHandler wires a QueryHandler against the given repository.
func NewQueryHandler(repo {{.R.Snake}}.Repository) *QueryHandler {
	return &QueryHandler{repo: repo}
}

// HandleGet fetches a single {{.R.Snake}} aggregate by id.
func (h *QueryHandler) HandleGet(ctx context.Context, q Get{{.R.Pascal}}Query) (*{{.R.Snake}}.{{.R.Pascal}}, error) {
	id, err := uuid.Parse(q.ID)
	if err != nil {
		return nil, fmt.Errorf("get {{.R.Snake}}: %w", err)
	}
	return h.repo.Get(ctx, id)
}

// HandleList returns every persisted {{.R.Snake}} aggregate.
func (h *QueryHandler) HandleList(ctx context.Context, _ List{{.R.PascalPlural}}Query) ([]*{{.R.Snake}}.{{.R.Pascal}}, error) {
	return h.repo.List(ctx)
}
