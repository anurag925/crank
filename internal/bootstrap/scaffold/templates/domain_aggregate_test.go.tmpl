func Test{{.R.Pascal}}_PullEvents(t *testing.T) {
	id := uuid.MustParse("123e4567-e89b-12d3-a456-426614174000")
{{- if .Fields}}
	o, err := New{{.R.Pascal}}(id{{range .Fields}}, {{.Sample}}{{end}})
{{- else}}
	o, err := New{{.R.Pascal}}(id)
{{- end}}
	require.NoError(t, err)

	events := o.PullEvents()
	require.Len(t, events, 1)
	assert.Equal(t, "{{.R.Snake}}.created", events[0].EventName())
	assert.WithinDuration(t, time.Now(), events[0].OccurredAt(), time.Second)

	// Second call returns nothing.
	assert.Empty(t, o.PullEvents())
}
