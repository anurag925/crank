func Test{{.R.Pascal}}QueryHandler_HandleGet(t *testing.T) {
	repo := memory.New{{.R.Pascal}}Repository()
	// Seed a value directly.
	id := uuid.MustParse("123e4567-e89b-12d3-a456-426614174000")
	seed, err := {{.R.Snake}}.New{{.R.Pascal}}(id{{range .Fields}}, {{.Sample}}{{end}})
	require.NoError(t, err)
	require.NoError(t, repo.Save(context.Background(), seed))

	h := NewQueryHandler(repo)
	got, err := h.HandleGet(context.Background(), Get{{.R.Pascal}}Query{ID: id.String()})
	require.NoError(t, err)
	assert.Equal(t, id, got.ID)
}

