package bun

import (
	"context"
	"database/sql"
	"errors"
	"time"

	"github.com/uptrace/bun"

	"{{.Module}}/internal/domain/{{.R.Snake}}"
)

// {{.R.Snake}}Row is the postgres row DTO for {{.R.Snake}} aggregates. It is
// intentionally private to this package: the domain aggregate is the only
// public contract.
type {{.R.Snake}}Row struct {
	ID        string    `bun:"id,pk,type:uuid"`
{{- range .Fields}}
	{{.GoName}} {{.GoType}} `bun:"{{.Name}},notnull,type:{{.SQLType}}"`
{{- end}}
	CreatedAt time.Time `bun:"created_at,nullzero,notnull,default:current_timestamp"`
	UpdatedAt time.Time `bun:"updated_at,nullzero,notnull,default:current_timestamp"`
}

// toAggregate converts a row to a domain aggregate, ignoring the error from
// New{{.R.Pascal}}ID because the column type guarantees the value is a
// non-empty uuid at the database level.
func (row *{{.R.Snake}}Row) toAggregate() *{{.R.Snake}}.{{.R.Pascal}} {
	id, _ := {{.R.Snake}}.New{{.R.Pascal}}ID(row.ID)
	return {{.R.Snake}}.Rehydrate(
		id,
{{- range .Fields}}
		row.{{.GoName}},
{{- end}}
		row.CreatedAt,
		row.UpdatedAt,
	)
}

// {{.R.Snake}}RowFromAggregate returns the row representation of an aggregate.
// Only the fields the user declared plus the typed id and timestamps are
// projected.
func {{.R.Snake}}RowFromAggregate(x *{{.R.Snake}}.{{.R.Pascal}}) *{{.R.Snake}}Row {
	return &{{.R.Snake}}Row{
		ID: x.ID().String(),
{{- range .Fields}}
		{{.GoName}}: x.{{.GoName}}(),
{{- end}}
	}
}

// {{.R.Pascal}}Repository is the postgres-backed implementation of
// domain/{{.R.Snake}}.Repository.
type {{.R.Pascal}}Repository struct {
	db *bun.DB
}

// New{{.R.Pascal}}Repository constructs a Bun-backed {{.R.Pascal}}Repository.
func New{{.R.Pascal}}Repository(db *bun.DB) *{{.R.Pascal}}Repository {
	return &{{.R.Pascal}}Repository{db: db}
}

// Save inserts a new row or updates an existing one keyed by id.
func (r *{{.R.Pascal}}Repository) Save(ctx context.Context, x *{{.R.Snake}}.{{.R.Pascal}}) error {
	_, err := r.db.NewInsert().
		Model({{.R.Snake}}RowFromAggregate(x)).
		On("CONFLICT (id) DO UPDATE SET " + {{.R.Snake}}OnConflictSet()).
		Exec(ctx)
	return err
}

// {{.R.Snake}}OnConflictSet builds the SET clause for Save's UPSERT. It
// references every user-declared column plus the updated_at timestamp.
func {{.R.Snake}}OnConflictSet() string {
	return "{{range .Fields}}{{.Name}} = EXCLUDED.{{.Name}}, {{end}}updated_at = EXCLUDED.updated_at"
}

// Get returns a {{.R.Snake}} aggregate by id, mapping sql.ErrNoRows to
// domain/{{.R.Snake}}.Err{{.R.Pascal}}NotFound.
func (r *{{.R.Pascal}}Repository) Get(ctx context.Context, id {{.R.Snake}}.{{.R.Pascal}}ID) (*{{.R.Snake}}.{{.R.Pascal}}, error) {
	row := new({{.R.Snake}}Row)
	err := r.db.NewSelect().Model(row).Where("id = ?", id.String()).Scan(ctx)
	if errors.Is(err, sql.ErrNoRows) {
		return nil, {{.R.Snake}}.Err{{.R.Pascal}}NotFound
	}
	if err != nil {
		return nil, err
	}
	return row.toAggregate(), nil
}

// List returns every {{.R.Snake}} row as a domain aggregate.
func (r *{{.R.Pascal}}Repository) List(ctx context.Context) ([]*{{.R.Snake}}.{{.R.Pascal}}, error) {
	var rows []{{.R.Snake}}Row
	if err := r.db.NewSelect().Model(&rows).OrderExpr("id ASC").Scan(ctx); err != nil {
		return nil, err
	}
	out := make([]*{{.R.Snake}}.{{.R.Pascal}}, 0, len(rows))
	for i := range rows {
		out = append(out, rows[i].toAggregate())
	}
	return out, nil
}

// Delete removes a {{.R.Snake}} row by id, mapping zero affected rows to
// domain/{{.R.Snake}}.Err{{.R.Pascal}}NotFound.
func (r *{{.R.Pascal}}Repository) Delete(ctx context.Context, id {{.R.Snake}}.{{.R.Pascal}}ID) error {
	res, err := r.db.NewDelete().Model((*{{.R.Snake}}Row)(nil)).Where("id = ?", id.String()).Exec(ctx)
	if err != nil {
		return err
	}
	if n, _ := res.RowsAffected(); n == 0 {
		return {{.R.Snake}}.Err{{.R.Pascal}}NotFound
	}
	return nil
}
